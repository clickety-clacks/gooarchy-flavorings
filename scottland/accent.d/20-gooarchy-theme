#!/bin/sh
# The Gooarchy theme's accent color for the focused window's halo, in the desktop's light or dark
# mode. With --watch-paths: where a light/dark switch writes. With --palette: the theme's colors
# as Scottland's palette (JSON), for widgets.
if [ "${1:-}" = --watch-paths ]; then
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/dconf"
  exit 0
fi
variant=$(/usr/lib/gooarchy-flavorings/gooarchy-theme-lookup 2>/dev/null) || exit 0
colors=$variant/colors.toml
pick() { sed -n "s/^$1 *= *\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$colors" 2>/dev/null | head -1; }
if [ "${1:-}" = --palette ]; then
  printf '{"background": "%s", "foreground": "%s", "muted": "%s", "accent": "%s", "alert": "%s", "attention": "%s"}\n' \
    "$(pick lighter_background)" "$(pick foreground)" "$(pick light_foreground)" "$(pick accent)" \
    "$(pick red)" "$(pick yellow)"
  exit 0
fi
pick accent
