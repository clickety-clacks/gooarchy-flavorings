#!/bin/sh
# Switch Gooarchy between its light and dark theme (Watercolor Dream).
#   gooarchy-theme            print the current mode, and whether Sunlight switches it
#   gooarchy-theme light|dark|toggle
# Sets the desktop's color-scheme preference; Scottland's halos, the wallpaper, Ghostty and GTK
# apps (through the settings portal) follow it. Strata and Chromium pick up Watercolor Dream too.
#
# Scottland's Sunlight schedule is on unless turned off (Scottland Settings > Sunlight, or
# enabled = false under [solar] in ~/.config/scottland/solar.ini). While it is on and knows the
# location (GeoClue, saved coordinates, or an IP lookup), a mode picked here holds until the next
# sunrise or sunset; Sunlight switches the mode then, not continuously.
key="org.gnome.desktop.interface color-scheme"
current() { case $(gsettings get $key) in *dark*) echo dark ;; *) echo light ;; esac; }
sunlight() {
  solar="${XDG_CONFIG_HOME:-$HOME/.config}/scottland/solar.ini"
  value=$(sed -n 's/^[[:space:]]*enabled[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$solar" 2>/dev/null | head -1)
  case ${value:-true} in true | yes | 1 | on) return 0 ;; *) return 1 ;; esac
}
warn() {
  sunlight && echo "Note: Scottland's Sunlight schedule stays on after a manual theme pick, keeping that choice through periodic checks and changing it only at the next scheduled sunrise or sunset. Turn it off in Scottland Settings > Sunlight only if you want to keep one mode permanently." >&2
  return 0
}
integrations() {
  local_helper="$(dirname -- "$0")/../libexec/gooarchy-theme-integrations"
  if [ -x "$local_helper" ]; then
    "$local_helper" "$1"
  else
    /usr/lib/gooarchy-flavorings/gooarchy-theme-integrations "$1"
  fi
}
set_mode() {
  gsettings set $key "prefer-$1" && integrations "$1" && warn
}
case ${1:-} in
  "") echo "$(current) (Sunlight schedule: $(sunlight && echo on || echo off))" ;;
  light) set_mode light ;;
  dark) set_mode dark ;;
  toggle)
    if [ "$(current)" = dark ]; then set_mode light; else set_mode dark; fi
    ;;
  *) echo "usage: gooarchy-theme [light|dark|toggle]" >&2; exit 2 ;;
esac
