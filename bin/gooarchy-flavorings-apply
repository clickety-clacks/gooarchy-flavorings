#!/usr/bin/env python3
"""Fill in Gooarchy's per-user defaults (the flavorings that live in a home directory).

  gooarchy-flavorings-apply            apply what this user hasn't had yet, reporting each step
  gooarchy-flavorings-apply --session  the same, quietly, from the session's autostart
  gooarchy-flavorings-apply --list     show which defaults have been applied for this user
  gooarchy-flavorings-apply --override-report
                                       on Omarchy, list the flavorings that change what this user
                                       had in Scottland's override report (O20)

Each default is applied at most once per user (a marker in ~/.local/state/gooarchy/flavorings
remembers it), so changing it back later sticks. A default only fills a setting that isn't set:
a setting the user already has is left alone and reported (also in
~/.local/state/gooarchy/reports.log).

Files are changed carefully: an existing file keeps its permissions and owner (a new file holding
an app's private settings is created readable by the user only); the new contents are written to
a private temporary file and moved into place in one step, so an interrupted run leaves the old
file intact; a file that is a symlink (managed elsewhere, e.g. by a dotfiles tool) is left alone
and reported; settings of an app that is running are applied at a later login instead; and two
runs at once wait for each other.

On Omarchy, the look is Omarchy's: the color scheme, Chromium and Ghostty defaults are not applied
(and not marked, so they stay unapplied). Every flavoring that does change something this user had
is listed in Scottland's override report through a fragment in
~/.config/scottland/override-report.d/, rewritten only when its contents change.
"""
from contextlib import contextmanager
import fcntl
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "gooarchy"
MARKERS = STATE / "flavorings"
SHARE = Path("/usr/share/gooarchy-flavorings")
THEME_LOOKUP = Path("/usr/lib/gooarchy-flavorings/gooarchy-theme-lookup")
THEME_REFRESH = Path("/usr/lib/gooarchy-flavorings/gooarchy-theme-refresh")
SESSION = "--session" in sys.argv
OMARCHY = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy").is_dir()
REPORT = CONFIG / "scottland" / "override-report.d" / "gooarchy-flavorings.txt"
SET_BY_GOOARCHY = "set by Gooarchy\n"  # a marker's contents when the step changed the setting


class Declined(Exception):
    """A default that can't be applied safely; reported, and not retried."""


def say(message):
    if not SESSION:
        print(message)


def report(message):
    """A setting the user had that Gooarchy left alone (or changed), with the reason."""
    line = f"Gooarchy: {message}"
    print(line, file=sys.stderr)
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "reports.log", "a") as f:
        f.write(line + "\n")


def helper_path(installed, name):
    """Let the repository test run its source helpers without an install root."""
    source = Path(__file__).resolve().parent.parent / "libexec" / name
    return source if source.is_file() else installed


def write_file(path, text, new_mode=0o600):
    """Replace (or create) PATH with TEXT in one step, keeping an existing file's mode and owner."""
    path = Path(path)
    if path.is_symlink():
        raise Declined(f"{path} is a symlink (managed elsewhere?)")
    path.parent.mkdir(parents=True, exist_ok=True)
    old = path.stat() if path.exists() else None
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".gooarchy")  # mode 0600
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if old:
            try:
                os.chown(tmp, old.st_uid, old.st_gid)
            except PermissionError:
                pass
            os.chmod(tmp, stat.S_IMODE(old.st_mode))
        else:
            os.chmod(tmp, new_mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise
    dirfd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)


def read_text(path):
    path = Path(path)
    if path.is_symlink():
        raise Declined(f"{path} is a symlink (managed elsewhere?)")
    return path.read_text() if path.exists() else None


def running(name):
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", name], capture_output=True).returncode == 0


def session_bus_env():
    env = dict(os.environ)
    bus = Path(f"/run/user/{os.getuid()}/bus")
    if "DBUS_SESSION_BUS_ADDRESS" not in env and bus.exists():
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    return env


def gsettings(*args):
    env = session_bus_env()
    command = ["gsettings", *args]
    if "DBUS_SESSION_BUS_ADDRESS" not in env:
        # No session bus (e.g. installing over SSH before the first login): dconf still needs one.
        command = ["dbus-run-session", "--", *command]
    return subprocess.run(command, env=env, capture_output=True, text=True, check=True).stdout.strip()


def sunlight_enabled():
    """Scottland's Sunlight schedule (on unless turned off in Scottland Settings)."""
    solar = CONFIG / "scottland" / "solar.ini"
    text = solar.read_text() if solar.exists() else ""
    match = re.search(r"^\s*enabled\s*=\s*(\S+)", text, re.M)
    return (match.group(1).lower() if match else "true") in ("true", "yes", "1", "on")


def folders():
    """The standard folders (Print saves screenshots in Pictures, wherever it is)."""
    subprocess.run(["xdg-user-dirs-update"], check=True)
    say("Created the standard folders (Desktop, Documents, Downloads, Pictures, ...).")
    return True


def color_scheme():
    """Set light mode unless the user already chose a color scheme (any value)."""
    # dconf read prints the user's own value, or nothing when the key was never set.
    explicit = subprocess.run(["dconf", "read", "/org/gnome/desktop/interface/color-scheme"],
                              capture_output=True, text=True).stdout.strip()
    if explicit:
        report(f"kept your color scheme ({explicit.strip(chr(39))}); gooarchy-theme light|dark switches it.")
    else:
        gsettings("set", "org.gnome.desktop.interface", "color-scheme", "prefer-light")
        say("Set the desktop to light mode (gooarchy-theme dark switches).")
    if sunlight_enabled():
        say("Scottland's Sunlight schedule is on: it switches between light and dark with the sun once it "
            "knows where you are (GeoClue, saved coordinates, or an IP lookup). Turn it off in Scottland "
            "Settings > Sunlight to keep one mode.")
    return True


def chromium():
    """Chromium draws no frame of its own: "Use system title bar and borders" is on."""
    prefs = CONFIG / "chromium" / "Default" / "Preferences"
    if running("chromium"):
        say("Chromium is running; its title bar setting will be applied at a later login.")
        return False
    text = read_text(prefs)
    if text is not None:
        data = json.loads(text or "{}")
        browser = data.setdefault("browser", {})
        if "custom_chrome_frame" in browser:
            if browser["custom_chrome_frame"]:
                report("kept Chromium drawing its own title bar (your setting); Gooarchy's default is "
                       "\"Use system title bar and borders\", so Scottland's goo and halo meet the window's edge.")
            return True
        browser["custom_chrome_frame"] = False
    else:
        data = {"browser": {"custom_chrome_frame": False}}
    write_file(prefs, json.dumps(data))
    say("Chromium: \"Use system title bar and borders\" is on.")
    return True


def ghostty():
    """Ghostty follows the selected theme through the per-user current-theme location."""
    current_theme = (CONFIG / "gooarchy" / "current-theme").absolute()
    line = f"theme = light:{current_theme}/light/ghostty,dark:{current_theme}/dark/ghostty"
    config = CONFIG / "ghostty" / "config"
    text = read_text(config)
    if text is not None:
        if not re.search(r"^\s*theme\s*=", text, re.M):
            report(f"kept your Ghostty config as it is; for Gooarchy's theme, add: {line}")
        return True
    if (current_theme.is_symlink() or not current_theme.is_dir()
            or not all((current_theme / mode).is_symlink() for mode in ("light", "dark"))):
        print("Gooarchy: current theme is not ready; Ghostty setup will retry next session.", file=sys.stderr)
        return False
    write_file(config, "# Gooarchy flavorings: follow the selected theme and desktop mode.\n"
                       f"{line}\n", new_mode=0o644)
    say("Ghostty: set to follow the selected theme.")
    return True


def claude_code():
    """Claude Code rings the terminal bell when it needs the user (Scottland shows it as attention)."""
    if running("claude"):
        say("Claude Code is running; its bell setting will be applied at a later login.")
        return False
    config = HOME / ".claude.json"
    text = read_text(config)
    data = json.loads(text or "{}") if text is not None else {}
    current = data.get("preferredNotifChannel")
    if current is not None:
        if current != "terminal_bell":
            report(f"kept Claude Code's notification channel ({current}); Gooarchy's default is "
                   "terminal_bell, which Scottland turns into window attention.")
        return True
    data["preferredNotifChannel"] = "terminal_bell"
    write_file(config, json.dumps(data, indent=2) + "\n")
    set_by_gooarchy("claude-code")
    say("Claude Code: rings the terminal bell when it needs you.")
    return True


def codex():
    """Codex rings the terminal bell when it needs the user."""
    if running("codex"):
        say("Codex is running; its bell setting will be applied at a later login.")
        return False
    config = HOME / ".codex" / "config.toml"
    wanted = {"notifications": "true", "notification_method": '"bel"'}
    text = read_text(config)
    if text is None:
        write_file(config, "# Gooarchy flavorings: ring the terminal bell when Codex needs you.\n[tui]\n" +
                   "".join(f"{k} = {v}\n" for k, v in wanted.items()))
        set_by_gooarchy("codex")
        say("Codex: rings the terminal bell when it needs you.")
        return True
    tui = tomllib.loads(text).get("tui", {})
    method = tui.get("notification_method")
    if method is not None:
        if method != "bel":
            report(f"kept Codex's notification method ({method}); Gooarchy's default is bel, "
                   "which Scottland turns into window attention.")
        return True
    missing = {k: v for k, v in wanted.items() if k not in tui}
    lines = "".join(f"{k} = {v}\n" for k, v in missing.items())
    header = re.search(r"^\[tui\][ \t]*\n", text, re.M)
    if header:
        text = text[:header.end()] + lines + text[header.end():]
    elif "tui" in tomllib.loads(text):
        report(f"left {config} alone (its tui settings aren't in a [tui] table); for the bell, set "
               "tui.notification_method = \"bel\".")
        return True
    else:
        text = text.rstrip("\n") + "\n\n# Gooarchy flavorings: ring the terminal bell when Codex needs you.\n[tui]\n" + lines
    write_file(config, text)
    set_by_gooarchy("codex")
    say("Codex: rings the terminal bell when it needs you.")
    return True


def file_manager():
    """Strata opens folders (system default in a Scottland session); report a user's own choice."""
    user = CONFIG / "mimeapps.list"
    if OMARCHY and not desktop_file(STRATA):
        return True  # Strata isn't installed: folders open as they did, and there is nothing to report
    if user.exists():
        match = re.search(r"^inode/directory=(.*)$", user.read_text(), re.M)
        if match and "Strata" not in match.group(1):
            report(f"kept your folder handler ({match.group(1)}); Gooarchy's is Strata.")
    return True


def set_by_gooarchy(name):
    """Remember that this step changed the setting, for the override report."""
    MARKERS.mkdir(parents=True, exist_ok=True)
    (MARKERS / name).write_text(SET_BY_GOOARCHY)


def still_set_by_gooarchy(name, current, ours):
    marker = MARKERS / name
    return current == ours and marker.is_file() and marker.read_text() == SET_BY_GOOARCHY


# Scottland's Omarchy override report (O20) -----------------------------------------------------

STRATA = "io.github.lgse.Strata.desktop"
SCOTTLAND_DESKTOPS = ("scottland", "wayfire", "wlroots")  # Scottland's XDG_CURRENT_DESKTOP
MIME_NAMES = {"inode/directory": "Folders", "text/html": "Web pages",
              "x-scheme-handler/http": "http links", "x-scheme-handler/https": "https links"}


def xdg_dirs(variable, default):
    return [Path(d) for d in (os.environ.get(variable) or default).split(":") if d]


def data_dirs():
    return [Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share"),
            *xdg_dirs("XDG_DATA_DIRS", "/usr/local/share:/usr/share")]


def desktop_file(desktop_id):
    """The installed desktop file for DESKTOP_ID, or None."""
    for directory in data_dirs():
        path = directory / "applications" / desktop_id
        if path.is_file():
            return path
    return None


def app_name(desktop_id):
    path = desktop_file(desktop_id)
    match = re.search(r"^Name=(.+)$", path.read_text(errors="replace"), re.M) if path else None
    return f"{match.group(1).strip()} ({desktop_id})" if match else desktop_id


def mimeapps_lists():
    """The mimeapps.list files of a Scottland session, in the XDG lookup order."""
    directories = [CONFIG, *xdg_dirs("XDG_CONFIG_DIRS", "/etc/xdg"),
                   *(d / "applications" for d in data_dirs())]
    return [directory / name for directory in directories
            for name in (*(f"{desktop}-mimeapps.list" for desktop in SCOTTLAND_DESKTOPS), "mimeapps.list")]


def default_apps(path):
    """PATH's [Default Applications]: {mime type: [desktop ids]}."""
    defaults, section = {}, None
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return defaults
    for line in lines:
        line = line.strip()
        if line.startswith("["):
            section = line
        elif section == "[Default Applications]" and "=" in line and not line.startswith("#"):
            mime, apps = (part.strip() for part in line.split("=", 1))
            defaults.setdefault(mime, [app for app in apps.split(";") if app])
    return defaults


@contextmanager
def xdg_config_dirs_without(excluded):
    """Mirror XDG config dirs' MIME lists, omitting one package list for an effective-default query."""
    excluded = Path(excluded).resolve()
    with tempfile.TemporaryDirectory(prefix="gooarchy-mimeapps-") as scratch:
        mirrors = []
        for index, source in enumerate(xdg_dirs("XDG_CONFIG_DIRS", "/etc/xdg")):
            mirror = Path(scratch) / str(index)
            mirror.mkdir()
            if source.is_dir():
                for path in source.iterdir():
                    if not path.is_file() or (path.name != "mimeapps.list" and not path.name.endswith("-mimeapps.list")):
                        continue
                    if path.resolve() != excluded:
                        shutil.copyfile(path, mirror / path.name)
            mirrors.append(str(mirror))
        yield ":".join(mirrors)


def gio_default_app(mime, config_dirs=None):
    """Return the effective handler GIO selects for a Scottland session, or None if there is none."""
    env = dict(os.environ)
    env["XDG_CURRENT_DESKTOP"] = "Scottland:Wayfire:wlroots"
    env["LC_ALL"] = "C"
    if config_dirs is not None:
        env["XDG_CONFIG_DIRS"] = config_dirs
    result = subprocess.run(["gio", "mime", mime], env=env, capture_output=True, text=True)
    output = result.stdout + result.stderr
    if result.returncode:
        if "No default application" in output:
            return None
        raise RuntimeError(f"gio mime {mime} failed (exit {result.returncode}): {output.strip()}")
    match = re.search(r"^Default application for .+?:\s*(\S+)\s*$", output, re.M)
    if match:
        return match.group(1)
    if "No default application" in output:
        return None
    raise RuntimeError(f"gio mime {mime} did not identify its default application (exit {result.returncode})")


def mime_entries():
    lists = mimeapps_lists()
    ours = next((path for path in lists if path.name == "scottland-mimeapps.list" and path.parent != CONFIG
                 and path.is_file()), None)
    if not ours:
        return []
    entries = []
    with xdg_config_dirs_without(ours) as config_dirs:
        for mime, apps in default_apps(ours).items():
            now = gio_default_app(mime)
            was = gio_default_app(mime, config_dirs)
            if now in apps and now != was:
                entries.append((MIME_NAMES.get(mime, mime), app_name(was) if was else "No default app",
                                f"{app_name(now)} in a Scottland session"))
    return entries


def bell_entries():
    entries = []
    try:
        claude = json.loads(read_text(HOME / ".claude.json") or "{}").get("preferredNotifChannel")
    except (Declined, ValueError, AttributeError):
        claude = None
    if still_set_by_gooarchy("claude-code", claude, "terminal_bell"):
        entries.append(("Claude Code notifications", "Claude Code's own default notification channel",
                        "Rings the terminal bell (preferredNotifChannel = terminal_bell in ~/.claude.json)"))
    try:
        method = tomllib.loads(read_text(HOME / ".codex" / "config.toml") or "").get("tui", {}).get("notification_method")
    except (Declined, ValueError, AttributeError):
        method = None
    if still_set_by_gooarchy("codex", method, "bel"):
        entries.append(("Codex notifications", "Codex's own default notification method",
                        "Rings the terminal bell (tui.notification_method = \"bel\" in ~/.codex/config.toml)"))
    return entries


def user_sets(files, pattern):
    matcher = re.compile(pattern, re.M)
    for path in files:
        try:
            for line in path.read_text(errors="replace").splitlines():
                # A comment that mentions a setting does not express the user's choice.
                statement = line.split("#", 1)[0]
                if matcher.search(statement):
                    return True
        except OSError:
            pass
    return False


def title_entries():
    entries = []
    if shutil.which("tmux"):
        tmux = [HOME / ".tmux.conf", CONFIG / "tmux" / "tmux.conf", HOME / ".config" / "tmux" / "tmux.conf"]
        if not user_sets(tmux, r"^\s*set(-option)?\s+(-\w+\s+)*set-titles\s"):
            entries.append(("tmux set-titles", "Off (tmux's default)",
                            "On: tmux sets the terminal's title (/etc/tmux.conf)"))
        if not user_sets(tmux, r"^\s*set(-option)?\s+(-\w+\s+)*set-titles-string\s"):
            entries.append(("tmux set-titles-string", "tmux's default title",
                            "The session and host, \"#S on #h\" (/etc/tmux.conf)"))
    if shutil.which("mosh-client"):
        startup = [HOME / name for name in (".profile", ".bash_profile", ".bash_login", ".bashrc",
                                            ".zshenv", ".zprofile", ".zshrc")]
        startup += sorted((CONFIG / "environment.d").glob("*.conf"))
        if not user_sets(startup,
                         r"^\s*(?:(?:export|readonly)\s+|(?:declare|typeset)\s+-x\s+)?MOSH_TITLE_NOPREFIX="):
            entries.append(("mosh window titles", "mosh puts [mosh] before the remote title",
                            "The remote title alone (MOSH_TITLE_NOPREFIX=1, /etc/profile.d/gooarchy-flavorings.sh)"))
    return entries


REPORT_GROUPS = (
    ("Gooarchy: tools ring the terminal bell",
     "Claude Code and Codex ring the terminal bell when they need you; Scottland shows it as window attention.",
     bell_entries),
    ("Gooarchy: terminal titles",
     "Gooarchy's system settings for tmux and mosh make window titles show where you are.",
     title_entries),
    ("Gooarchy: default apps",
     "In a Scottland session Gooarchy's default apps come before Omarchy's; your own choices still win.",
     mime_entries),
)


def override_report():
    """Write (or remove) this user's fragment of Scottland's override report, only when it changes."""
    text = ""
    for heading, reason, entries in REPORT_GROUPS:
        items = entries()
        if items:
            text += f"## {heading}\nReason: {reason}\n\n"
            text += "".join(f"- Keys: {keys}\n  Was: {was}\n  Now: {now}\n  Origin: Gooarchy flavoring\n\n"
                            for keys, was, now in items)
    text = text.rstrip("\n") + "\n" if text else ""
    old = REPORT.read_text() if REPORT.is_file() and not REPORT.is_symlink() else None
    if text and text != old:
        write_file(REPORT, text, new_mode=0o644)
    elif not text and old is not None:
        REPORT.unlink()
    REPORT.parent.mkdir(parents=True, exist_ok=True)  # Scottland watches it once it exists


GOOARCHY_ONLY = {"color-scheme", "chromium", "ghostty"}  # the look; on Omarchy it's Omarchy's

STEPS = [("folders", folders), ("color-scheme", color_scheme), ("chromium", chromium),
         ("ghostty", ghostty), ("claude-code", claude_code), ("codex", codex),
         ("file-manager", file_manager)]


def main():
    if "--list" in sys.argv:
        for name, _ in STEPS:
            if OMARCHY and name in GOOARCHY_ONLY:
                print(f"{name}: Omarchy's own")
            else:
                print(f"{name}: {'applied' if (MARKERS / name).exists() else 'not yet'}")
        return 0
    MARKERS.mkdir(parents=True, exist_ok=True)
    with open(STATE / "flavorings.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # one run at a time (installer, session autostart, config build)
        if "--override-report" in sys.argv:
            if OMARCHY:
                override_report()
            return 0
        failed = False
        if not OMARCHY:
            try:
                refresh_path = helper_path(THEME_REFRESH, "gooarchy-theme-refresh")
                refresh = subprocess.run([str(refresh_path)], capture_output=True, text=True)
                if refresh.returncode != 0:
                    detail = refresh.stderr.strip() or "theme refresh failed"
                    print(f"Gooarchy: {detail}", file=sys.stderr)
                    failed = True
            except OSError as error:
                print(f"Gooarchy: could not run theme refresh: {error}", file=sys.stderr)
                failed = True
        for name, step in STEPS:
            if (MARKERS / name).exists() or (OMARCHY and name in GOOARCHY_ONLY):
                continue
            try:
                if step():
                    (MARKERS / name).touch()
            except Declined as why:
                report(f"left the {name} default unapplied: {why}.")
                (MARKERS / name).touch()
            except Exception as error:  # one default failing shouldn't stop the others
                print(f"Gooarchy: couldn't apply the {name} default: {error}", file=sys.stderr)
                failed = True
        if OMARCHY:
            try:
                override_report()
            except Exception as error:
                print(f"Gooarchy: couldn't update the override report: {error}", file=sys.stderr)
                failed = True
    return 1 if failed and not SESSION else 0


if __name__ == "__main__":
    sys.exit(main())
