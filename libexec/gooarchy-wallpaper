#!/usr/bin/env python3
"""Draw the selected theme and keep Strata and Chromium on the same variant."""
import fcntl
import os
import select
import signal
import stat
import subprocess
import sys
import uuid
from pathlib import Path

LOOKUP = Path(__file__).with_name("gooarchy-theme-lookup")
INTEGRATIONS = Path(__file__).with_name("gooarchy-theme-integrations")
IMAGE_SUFFIXES = {".webp", ".png", ".jpg", ".jpeg"}
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CURRENT_THEME = CONFIG_HOME / "gooarchy" / "current-theme"
RUNTIME_LOCK = "gooarchy-wallpaper.lock"
REFRESH_REQUEST = "gooarchy-wallpaper.request"
REFRESH_ACK = "gooarchy-wallpaper.ack"


def variant_path():
    result = subprocess.run([str(LOOKUP)], capture_output=True, text=True, check=True, timeout=5)
    return Path(result.stdout.strip())


def first_background(variant):
    backgrounds = variant / "backgrounds"
    files = sorted(
        (path for path in backgrounds.iterdir()
         if path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES),
        key=lambda path: os.fsencode(path.name),
    )
    if not files:
        raise RuntimeError(f"no supported background in {variant.name}")
    return files[0]


def draw():
    return subprocess.Popen(["swaybg", "--mode", "fill", "--image", str(first_background(variant_path()))])


def update_integrations():
    try:
        result = subprocess.run([str(INTEGRATIONS)], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as error:
        print(f"Gooarchy: theme app integrations failed: {error}", file=sys.stderr)
        return False
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        print(f"Gooarchy: theme app integrations failed: {detail}", file=sys.stderr)
        return False
    return True


def current_theme_signature():
    signature = []
    for mode in ("light", "dark"):
        link = CURRENT_THEME / mode
        try:
            metadata = link.lstat()
            signature.append((metadata.st_ino, metadata.st_mtime_ns, os.readlink(link)))
        except OSError:
            signature.append(None)
    return tuple(signature)


def open_runtime_control():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not Path(runtime).is_dir() or not os.environ.get("WAYLAND_DISPLAY"):
        return None, None, None
    runtime_path = Path(runtime)
    lock_path = runtime_path / RUNTIME_LOCK
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    lock_fd = os.open(lock_path, flags, 0o600)
    try:
        metadata = os.fstat(lock_fd)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise RuntimeError(f"refusing unexpected wallpaper lock: {lock_path}")
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        os.close(lock_fd)
        raise RuntimeError("gooarchy-wallpaper is already running") from error
    except BaseException:
        os.close(lock_fd)
        raise
    return lock_fd, runtime_path / REFRESH_REQUEST, runtime_path / REFRESH_ACK


def read_runtime_token(path):
    if path is None:
        return ""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return ""
    with os.fdopen(fd, "r") as stream:
        return stream.read(128).strip()


def write_runtime_token(path, token):
    if path is None:
        return
    temp = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(token + "\n")
            stream.flush()
        os.replace(temp, path)
    except BaseException:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass
        raise


def stop_child(process):
    if process is None or process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def main():
    if Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy").is_dir():
        return 0

    def stop(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    lock_fd, request_path, ack_path = open_runtime_control()
    monitor = None
    swaybg = None
    try:
        monitor = subprocess.Popen(["gsettings", "monitor", "org.gnome.desktop.interface", "color-scheme"],
                                   stdout=subprocess.PIPE, text=True)
        swaybg = draw()
        if swaybg.poll() is not None:
            raise RuntimeError("swaybg exited during wallpaper startup")
        theme_signature = current_theme_signature()
        last_request = read_runtime_token(ack_path)
        update_integrations()
        while True:
            readers = [monitor.stdout] if monitor.stdout is not None else []
            ready, _, _ = select.select(readers, [], [], 1.0)
            redraw = False
            request = read_runtime_token(request_path)
            requested = bool(request and request != last_request)
            if requested:
                # Process each token once; a failed refresh stays unacknowledged for its caller.
                last_request = request
                redraw = True
            if monitor.stdout is not None and monitor.stdout in ready:
                if not monitor.stdout.readline():
                    monitor.stdout.close()
                    monitor.stdout = None  # keep the wallpaper, but continue servicing refresh requests
                else:
                    redraw = True
            elif swaybg.poll() is not None and not redraw:
                break
            new_signature = current_theme_signature()
            if new_signature != theme_signature:
                theme_signature = new_signature
                redraw = True
            if redraw:
                if swaybg.poll() is None:
                    swaybg.terminate()
                    swaybg.wait()
                swaybg = draw()
                if swaybg.poll() is not None:
                    raise RuntimeError("swaybg exited during wallpaper refresh")
                integrations_updated = update_integrations()
                if requested and integrations_updated:
                    write_runtime_token(ack_path, request)
        if swaybg is not None:
            swaybg.wait()
    finally:
        stop_child(monitor)
        stop_child(swaybg)
        if lock_fd is not None:
            os.close(lock_fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
