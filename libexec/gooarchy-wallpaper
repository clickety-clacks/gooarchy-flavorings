#!/usr/bin/env python3
"""Draw the theme's wallpaper (swaybg) for the current light/dark mode, and redraw it when the mode
changes (org.gnome.desktop.interface color-scheme, which gooarchy-theme sets). Exits when the
session does: swaybg ending on its own means the compositor is gone."""
import select
import subprocess
from pathlib import Path
import sys

THEMES = "/usr/share/gooarchy-flavorings/themes"


def mode():
    scheme = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
                            capture_output=True, text=True).stdout
    return "dark" if "dark" in scheme else "light"


def draw():
    return subprocess.Popen(["swaybg", "--mode", "fill", "--image",
                             f"{THEMES}/watercolor-dream-{mode()}/background.webp"])


def update_integrations():
    helper = Path(__file__).with_name("gooarchy-theme-integrations")
    result = subprocess.run([str(helper), mode()], capture_output=True, text=True)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        print(f"Gooarchy: theme app integrations failed: {detail}", file=sys.stderr)


monitor = subprocess.Popen(["gsettings", "monitor", "org.gnome.desktop.interface", "color-scheme"],
                           stdout=subprocess.PIPE, text=True)
swaybg = draw()
try:
    update_integrations()
    while True:
        ready, _, _ = select.select([monitor.stdout], [], [], 1.0)
        if ready:
            if not monitor.stdout.readline():
                break  # the monitor died; keep the current wallpaper until the session ends
            swaybg.terminate()
            swaybg.wait()
            swaybg = draw()
            update_integrations()
        elif swaybg.poll() is not None:
            break
    swaybg.wait()
finally:
    monitor.terminate()
    if swaybg.poll() is None:
        swaybg.terminate()
