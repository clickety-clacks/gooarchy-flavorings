#!/usr/bin/env python3
"""Draw the selected theme and keep Strata and Chromium on the same variant."""
import os
import select
import subprocess
import sys
from pathlib import Path

LOOKUP = Path(__file__).with_name("gooarchy-theme-lookup")
INTEGRATIONS = Path(__file__).with_name("gooarchy-theme-integrations")
IMAGE_SUFFIXES = {".webp", ".png", ".jpg", ".jpeg"}
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CURRENT_THEME = CONFIG_HOME / "gooarchy" / "current-theme"


def variant_path():
    result = subprocess.run([str(LOOKUP)], capture_output=True, text=True, check=True, timeout=5)
    return Path(result.stdout.strip())


def first_background(variant):
    backgrounds = variant / "backgrounds"
    files = sorted(
        (path for path in backgrounds.iterdir()
         if path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES),
        key=lambda path: os.fsencode(path.name),
    )
    if not files:
        raise RuntimeError(f"no supported background in {variant.name}")
    return files[0]


def draw():
    return subprocess.Popen(["swaybg", "--mode", "fill", "--image", str(first_background(variant_path()))])


def update_integrations():
    try:
        result = subprocess.run([str(INTEGRATIONS)], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as error:
        print(f"Gooarchy: theme app integrations failed: {error}", file=sys.stderr)
        return False
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        print(f"Gooarchy: theme app integrations failed: {detail}", file=sys.stderr)
        return False
    return True


def current_theme_signature():
    signature = []
    for mode in ("light", "dark"):
        link = CURRENT_THEME / mode
        try:
            metadata = link.lstat()
            signature.append((metadata.st_ino, metadata.st_mtime_ns, os.readlink(link)))
        except OSError:
            signature.append(None)
    return tuple(signature)


def main():
    monitor = subprocess.Popen(["gsettings", "monitor", "org.gnome.desktop.interface", "color-scheme"],
                               stdout=subprocess.PIPE, text=True)
    swaybg = draw()
    theme_signature = current_theme_signature()
    try:
        update_integrations()
        while True:
            ready, _, _ = select.select([monitor.stdout], [], [], 1.0)
            redraw = False
            if ready:
                if not monitor.stdout.readline():
                    break  # the monitor died; keep the current wallpaper until the session ends
                redraw = True
            elif swaybg.poll() is not None:
                break
            new_signature = current_theme_signature()
            if new_signature != theme_signature:
                theme_signature = new_signature
                redraw = True
            if redraw:
                swaybg.terminate()
                swaybg.wait()
                swaybg = draw()
                if swaybg.poll() is not None:
                    raise RuntimeError("swaybg exited during wallpaper refresh")
                update_integrations()
        swaybg.wait()
    finally:
        monitor.terminate()
        if swaybg.poll() is None:
            swaybg.terminate()
    return 0


if __name__ == "__main__":
    sys.exit(main())
