#!/usr/bin/env python3
"""Keep Strata's Gooarchy theme entry and Chromium's managed color in sync."""
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from xml.etree import ElementTree


CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
LOOKUP = Path(__file__).with_name("gooarchy-theme-lookup")
OMARCHY = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy").is_dir()
STRATA_DEFAULT_THEME = "tokyo-night"
STRATA_THEME_ID = "gooarchy-watercolor"
STRATA_THEME_MARKER = "# Managed by Gooarchy flavorings. Do not edit."
POLICY_DIR = Path("/etc/chromium/policies/managed")
POLICY_FILE = POLICY_DIR / "gooarchy-theme.json"
POLICY_WRITER = "/usr/lib/gooarchy-flavorings/gooarchy-browser-policy"
FONTCONFIG_FRAGMENT = Path("fontconfig/conf.d/99-gooarchy-monospace.conf")
GHOSTTY_FRAGMENT = Path("gooarchy/font.ghostty")
GHOSTTY_INCLUDE_MARKER = "# Gooarchy managed monospace font include."
GHOSTTY_SERVICE = "app-com.mitchellh.ghostty.service"


def atomic_write(path, text, mode=0o600):
    """Replace a user file in one step, retaining an existing file's owner and mode."""
    path = Path(path)
    if path.is_symlink():
        raise OSError(f"{path} is a symlink")
    path.parent.mkdir(parents=True, exist_ok=True)
    old = path.stat() if path.exists() else None
    if old and old.st_uid != os.getuid():
        raise OSError(f"{path} is not owned by this user")
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".gooarchy")
    try:
        mode_for_open = "wb" if isinstance(text, bytes) else "w"
        with os.fdopen(fd, mode_for_open) as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        if old:
            os.chown(temporary, old.st_uid, old.st_gid)
            os.chmod(temporary, stat.S_IMODE(old.st_mode))
        else:
            os.chmod(temporary, mode)
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def palette(mode=None):
    """Read colors only from the variant resolved by gooarchy-theme-lookup."""
    if mode is not None and mode not in ("light", "dark"):
        raise ValueError("expected light or dark")
    command = [str(LOOKUP)]
    if mode is not None:
        command.append(mode)
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"theme lookup failed: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or "lookup returned no variant"
        raise RuntimeError(f"theme lookup failed: {detail}")
    variant = Path(result.stdout.strip())
    if not variant.is_absolute():
        raise RuntimeError("theme lookup returned a non-absolute variant path")
    return tomllib.loads((variant / "colors.toml").read_text())


def strata_theme(values):
    fields = {
        "name": "Gooarchy",
        "background": values["background"],
        "surface": values["lighter_background"],
        "text": values["foreground"],
        "accent": values["accent"],
        "danger": values["red"],
        "muted": values["muted"],
        "highlight": values["selection"],
        "border": values.get("dark_background", values["background"]),
        "dim_text": values["muted"],
        "syntax_keyword": values["magenta"],
        "syntax_string": values["green"],
        "syntax_constant": values.get("orange", values["yellow"]),
        "syntax_type": values["yellow"],
        "syntax_preprocessor": values["cyan"],
    }
    lines = [STRATA_THEME_MARKER]
    lines.extend(f"{key} = {json.dumps(value)}" for key, value in fields.items())
    return "\n".join(lines) + "\n"


def replace_top_level_theme(text, theme_id):
    """Edit only the top-level theme key, preserving every other settings line."""
    lines = text.splitlines(keepends=True)
    in_table = False
    for index, line in enumerate(lines):
        stripped = line.lstrip()
        if stripped.startswith("["):
            in_table = True
        if in_table:
            continue
        match = re.match(r"^([ \t]*theme[ \t]*=[ \t]*)(.*?)(\r?\n)?$", line)
        if not match:
            continue
        right = match.group(2)
        comment_at = right.find("#")
        if comment_at >= 0:
            before_comment = right[:comment_at]
            suffix = before_comment[len(before_comment.rstrip()):] + right[comment_at:]
        else:
            suffix = right[len(right.rstrip()):]
        newline = match.group(3) or ""
        lines[index] = match.group(1) + json.dumps(theme_id) + suffix + newline
        return "".join(lines)

    newline = "\r\n" if "\r\n" in text else "\n"
    insert_at = next((i for i, line in enumerate(lines) if line.lstrip().startswith("[")), len(lines))
    if insert_at and not lines[insert_at - 1].endswith(("\n", "\r")):
        lines[insert_at - 1] += newline
    lines.insert(insert_at, f"theme = {json.dumps(theme_id)}{newline}")
    return "".join(lines)


def update_strata(resolved):
    """Use Gooarchy colors only for Strata's default or already selected Gooarchy theme."""
    strata_dir = CONFIG / "strata"
    settings = strata_dir / "settings.toml"
    themes_dir = strata_dir / "themes"
    theme_file = themes_dir / f"{STRATA_THEME_ID}.toml"
    if strata_dir.is_symlink() or themes_dir.is_symlink() or settings.is_symlink():
        return False

    if settings.exists():
        original = settings.read_text()
        try:
            saved = tomllib.loads(original)
        except tomllib.TOMLDecodeError:
            return False
        selected_mode = saved.get("mode", "theme")
        selected_theme = saved.get("theme", STRATA_DEFAULT_THEME)
        if selected_mode != "theme" or selected_theme not in (STRATA_DEFAULT_THEME, STRATA_THEME_ID):
            return False
    else:
        original = None

    if theme_file.is_symlink():
        return False
    if theme_file.exists():
        try:
            if theme_file.read_text().splitlines()[0] != STRATA_THEME_MARKER:
                return False
        except (OSError, IndexError):
            return False

    values = palette(resolved) if isinstance(resolved, str) else resolved
    rendered = strata_theme(values)
    if not theme_file.exists() or theme_file.read_text() != rendered:
        atomic_write(theme_file, rendered, mode=0o644)

    if original is None:
        updated = 'mode = "theme"\ntheme = "gooarchy-watercolor"\n'
    elif selected_theme != STRATA_THEME_ID:
        updated = replace_top_level_theme(original, STRATA_THEME_ID)
    else:
        updated = original
    if updated != original:
        atomic_write(settings, updated, mode=0o600)
    return True


def expected_policy(color):
    return json.dumps({"BrowserThemeColor": color, "BrowserColorScheme": "device"}, separators=(", ", ": ")) + "\n"


def policy_is_current(content):
    try:
        metadata = POLICY_FILE.lstat()
        return (stat.S_ISREG(metadata.st_mode) and metadata.st_uid == 0 and metadata.st_gid == 0
                and stat.S_IMODE(metadata.st_mode) == 0o644 and POLICY_FILE.read_text() == content)
    except OSError:
        return False


def chromium_running():
    pgrep = shutil.which("pgrep")
    if not pgrep:
        return False
    return subprocess.run([pgrep, "-u", str(os.getuid()), "-x", "chromium"],
                          capture_output=True).returncode == 0


def update_chromium(color):
    """Write one managed Chromium color and refresh an already running Chromium process."""
    chromium = shutil.which("chromium")
    if not chromium:
        return True
    content = expected_policy(color)
    policy_changed = not policy_is_current(content)
    if policy_changed:
        result = subprocess.run(["sudo", "-n", POLICY_WRITER, color.removeprefix("#").lower()],
                                capture_output=True, text=True)
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            print(f"Gooarchy: couldn't update Chromium's managed theme color: {detail}", file=sys.stderr)
            return False
    if policy_changed and chromium_running():
        result = subprocess.run([chromium, "--refresh-platform-policy", "--no-startup-window"],
                                capture_output=True, text=True)
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            print(f"Gooarchy: Chromium policy refresh failed: {detail}", file=sys.stderr)
            return False
    return True


def fontconfig_fragment_path():
    return CONFIG / FONTCONFIG_FRAGMENT


def ghostty_fragment_path():
    return CONFIG / GHOSTTY_FRAGMENT


def ghostty_config_path():
    directory = CONFIG / "ghostty"
    # Current Ghostty checks config.ghostty before the legacy config path; when both exist,
    # the latter is loaded afterwards and therefore owns the final value.
    legacy = directory / "config"
    modern = directory / "config.ghostty"
    if legacy.exists():
        return legacy
    if modern.exists():
        return modern
    return legacy


def fontconfig_monospace_families(run=None):
    run = run or subprocess.run
    fc_list = shutil.which("fc-list")
    if not fc_list:
        raise RuntimeError("Fontconfig fc-list is unavailable")
    result = run([fc_list, "--format=%{family[0]}\t%{spacing}\n"],
                 capture_output=True, text=True, timeout=10)
    if result.returncode:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"Fontconfig could not list installed fonts: {detail}")
    families = set()
    for line in result.stdout.splitlines():
        if "\t" not in line:
            continue
        family, spacing = line.rsplit("\t", 1)
        if family.strip() and "100" in {part.strip() for part in spacing.split(",")}:
            families.add(family.strip())
    return sorted(families, key=os.fsencode)


def ghostty_font_families(executable=None, run=None):
    run = run or subprocess.run
    executable = executable or shutil.which("ghostty")
    if not executable:
        return None
    result = run([executable, "+list-fonts"], capture_output=True, text=True, timeout=10)
    if result.returncode:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"Ghostty could not list its supported fonts: {detail}")
    families = set()
    for line in result.stdout.splitlines():
        if not line or line[0].isspace():
            continue
        family = line.strip()
        if family and family.lower() not in {"fonts", "available fonts"}:
            families.add(family)
    return families


def font_inventory(run=None):
    """List installed monospace families without requiring a Ghostty consumer."""
    run = run or subprocess.run
    return fontconfig_monospace_families(run=run)


def read_saved_font():
    path = fontconfig_fragment_path()
    if path.is_symlink():
        raise RuntimeError(f"refusing symlinked Gooarchy font preference: {path}")
    try:
        root = ElementTree.parse(path).getroot()
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError, ElementTree.ParseError) as error:
        raise RuntimeError(f"cannot read Gooarchy font preference: {error}") from error
    for match in root.findall("match"):
        edit = match.find("edit")
        if edit is not None and edit.get("name") == "family":
            family = edit.findtext("string")
            if family:
                return family
    raise RuntimeError("Gooarchy font preference has no selected monospace family")


def fontconfig_effective_family(run=None):
    run = run or subprocess.run
    fc_match = shutil.which("fc-match")
    if not fc_match:
        raise RuntimeError("Fontconfig fc-match is unavailable")
    result = run([fc_match, "--format=%{family[0]}\n", "monospace"],
                 capture_output=True, text=True, timeout=10)
    if result.returncode:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"Fontconfig could not resolve monospace: {detail}")
    family = result.stdout.strip()
    return family or None


def _ghostty_family_values(output):
    values = []
    for line in output.splitlines():
        match = re.match(r"^font-family[ \t]*=[ \t]*(.*?)[ \t]*$", line)
        if not match:
            continue
        value = match.group(1)
        if value.startswith('"') and value.endswith('"'):
            try:
                value = json.loads(value)
            except json.JSONDecodeError:
                pass
        if not value:
            values = []
        else:
            values.append(value)
    return values


def ghostty_configured_family(run=None, defaults=False):
    run = run or subprocess.run
    executable = shutil.which("ghostty")
    if not executable:
        return None, "Ghostty is unavailable"
    command = [executable, "+show-config"]
    if defaults:
        command.append("--default")
    try:
        result = run(command, capture_output=True, text=True, timeout=10)
    except (OSError, UnicodeError, subprocess.SubprocessError) as error:
        return None, f"Ghostty configuration could not be read: {error}"
    if result.returncode:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        return None, f"Ghostty configuration could not be read: {detail}"
    values = _ghostty_family_values(result.stdout)
    return (values[0] if values else None), None


def _fontconfig_fragment(family):
    import html
    return (
        '<?xml version="1.0"?>\n'
        '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">\n'
        '<fontconfig>\n'
        '  <match target="pattern">\n'
        '    <test name="family" compare="eq"><string>monospace</string></test>\n'
        '    <edit name="family" mode="prepend" binding="strong">\n'
        f'      <string>{html.escape(family)}</string>\n'
        '    </edit>\n'
        '  </match>\n'
        '</fontconfig>\n'
    )


def _ghostty_fragment(family):
    return f'font-family = ""\nfont-family = {json.dumps(family, ensure_ascii=False)}\n'


def _ghostty_include(content, fragment):
    absolute = fragment.absolute()
    directive = f"config-file = {json.dumps('?' + str(absolute), ensure_ascii=False)}"
    lines = content.splitlines(keepends=True)
    markers = [index for index, line in enumerate(lines)
               if line.rstrip("\r\n") == GHOSTTY_INCLUDE_MARKER]
    if len(markers) > 1:
        raise RuntimeError("Ghostty config contains duplicate Gooarchy font include markers")
    if markers:
        index = markers[0]
        if index + 1 >= len(lines) or lines[index + 1].rstrip("\r\n") != directive:
            raise RuntimeError("Gooarchy Ghostty font include marker was changed")
        return content
    if any(line.rstrip("\r\n") == directive for line in lines):
        return content
    separator = "" if not content or content.endswith(("\n", "\r")) else "\n"
    return f"{content}{separator}{GHOSTTY_INCLUDE_MARKER}\n{directive}\n"


def _snapshot(path):
    path = Path(path)
    if path.is_symlink():
        raise RuntimeError(f"refusing symlinked configuration file: {path}")
    try:
        metadata = path.stat()
        content = path.read_bytes()
        content.decode("utf-8")  # validate without universal-newline conversion
        return (content, stat.S_IMODE(metadata.st_mode))
    except FileNotFoundError:
        return None
    except UnicodeError as error:
        raise RuntimeError(f"configuration file is not valid UTF-8: {path}") from error


def _restore(path, snapshot):
    path = Path(path)
    if snapshot is None:
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        return
    content, mode = snapshot
    atomic_write(path, content, mode=mode)


def _session_ghostty_pids(proc_root=Path("/proc")):
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    display = os.environ.get("WAYLAND_DISPLAY")
    if not runtime or not display:
        return []
    expected = {"XDG_RUNTIME_DIR": runtime, "WAYLAND_DISPLAY": display}
    pids = []
    try:
        entries = list(Path(proc_root).iterdir())
    except OSError:
        return []
    for entry in entries:
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            comm = (entry / "comm").read_text(encoding="utf-8").strip()
            if comm != "ghostty":
                argv0 = (entry / "cmdline").read_bytes().split(b"\0", 1)[0]
                if not argv0 or Path(os.fsdecode(argv0)).name != "ghostty":
                    continue
            environment = {}
            for item in (entry / "environ").read_bytes().split(b"\0"):
                if b"=" in item:
                    name, value = item.split(b"=", 1)
                    environment[os.fsdecode(name)] = os.fsdecode(value)
            if all(environment.get(name) == value for name, value in expected.items()):
                pids.append(int(entry.name))
        except (OSError, ValueError):
            continue
    return sorted(pids)


def reload_ghostty(run=None):
    run = run or subprocess.run
    systemctl = shutil.which("systemctl")
    if systemctl:
        try:
            active = run([systemctl, "--user", "is-active", "--quiet", GHOSTTY_SERVICE],
                         capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            active = None
        if active is not None and active.returncode == 0:
            try:
                result = run([systemctl, "--user", "reload", GHOSTTY_SERVICE],
                             capture_output=True, text=True, timeout=10)
            except (OSError, subprocess.SubprocessError) as error:
                return False, f"Ghostty user-service reload failed: {error}"
            if result.returncode:
                detail = result.stderr.strip() or f"exit {result.returncode}"
                return False, f"Ghostty user-service reload failed: {detail}"
            return True, "Ghostty user-service reload requested"
    pids = _session_ghostty_pids()
    if not pids:
        return True, "no Ghostty process was found in this graphical session; saved for new windows"
    failures = []
    for pid in pids:
        try:
            os.kill(pid, signal.SIGUSR2)
        except OSError as error:
            failures.append(f"PID {pid}: {error}")
    if failures:
        return False, "Ghostty reload failed: " + "; ".join(failures)
    return True, "Ghostty reload requested for the current graphical session"


def font_current(output=None, error=None, run=None):
    output = output or sys.stdout
    error = error or sys.stderr
    run = run or subprocess.run
    if OMARCHY:
        print("Showing the current Fontconfig and Ghostty font state on Omarchy.", file=error)
    try:
        saved = read_saved_font()
        effective = fontconfig_effective_family(run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        print(f"Font state could not be read: {exception}", file=error)
        return 1
    print(f"Saved monospace family: {saved or 'none'}", file=output)
    print(f"Fontconfig effective monospace: {effective or 'unknown'}", file=output)
    ghostty_availability_error = None
    try:
        ghostty_bin = shutil.which("ghostty")
    except OSError as exception:
        ghostty_bin = None
        ghostty_availability_error = exception
    if not ghostty_bin:
        if ghostty_availability_error:
            print(f"Ghostty configured family: unknown (availability could not be checked: "
                  f"{ghostty_availability_error}).", file=output)
            print(f"Ghostty availability could not be checked: {ghostty_availability_error}; "
                  "Fontconfig state remains available.", file=error)
        else:
            print("Ghostty configured family: unknown (Ghostty is unavailable).", file=output)
            print("Ghostty is unavailable; Fontconfig state remains available.", file=error)
        return 0
    try:
        configured, config_error = ghostty_configured_family(run=run)
        default, default_error = ghostty_configured_family(run=run, defaults=True)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        configured, default = None, None
        config_error = default_error = str(exception)
    if config_error or default_error:
        detail = config_error or default_error
        print(f"Ghostty configured family: unknown ({detail}).", file=output)
        print(f"Ghostty configuration could not be read: {detail}; Fontconfig state remains available.",
              file=error)
        return 0
    if configured is None:
        configured = default
    label = "default" if configured == default else "configured"
    print(f"Ghostty {label} family: {configured or 'unknown'}", file=output)
    if saved:
        try:
            fontconfig = set(font_inventory(run=run))
        except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
            print(f"Fontconfig saved-family availability is unknown: {exception}; saved family "
                  f"{saved} and effective family {effective or 'unknown'} remain as shown.", file=error)
            return 0
        try:
            ghostty = ghostty_font_families(run=run)
            ghostty_error = None
        except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
            ghostty = None
            ghostty_error = exception
        available = (fontconfig if ghostty is None else
                     {family.casefold() for family in fontconfig}
                     & {family.casefold() for family in ghostty})
        if ghostty is None:
            detail = f"unknown ({ghostty_error})" if ghostty_error else "unknown"
            print(f"Ghostty font compatibility is {detail}; Fontconfig remains available.",
                  file=error)
        if saved.casefold() not in {family.casefold() for family in available}:
            print(f"Saved family is unavailable: {saved}", file=error)
            print(f"Fontconfig fallback: {effective or 'unknown'}", file=error)
        elif effective and saved.casefold() != effective.casefold():
            print(f"Fontconfig is using {effective}; the saved choice is {saved}.", file=error)
    return 0


def set_font(family, output=None, error=None, run=None):
    output = output or sys.stdout
    error = error or sys.stderr
    run = run or subprocess.run
    if not family.strip():
        print("A monospace family is required.", file=error)
        return 2
    try:
        families = font_inventory(run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        families = None
        print(f"Fontconfig inventory is unknown ({exception}); the requested preference will "
              "still be saved and its effective value reported.", file=error)
    selected = None if families is None else next(
        (installed for installed in families if installed.casefold() == family.casefold()), None)
    if families is not None and selected is None:
        print(f"Font is not an installed Fontconfig monospace family: {family}", file=error)
        return 2
    if selected is not None:
        family = selected

    try:
        ghostty_bin = shutil.which("ghostty")
    except OSError as exception:
        ghostty_bin = None
        print(f"Ghostty availability is unknown: {exception}; Fontconfig selection will continue.",
              file=error)
    ghostty_supported = True
    try:
        ghostty_families = ghostty_font_families(executable=ghostty_bin, run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        ghostty_families = None
        ghostty_supported = None
        print(f"Ghostty font compatibility is unknown: {exception}; Fontconfig selection will continue.",
              file=error)
    if ghostty_families is None:
        ghostty_supported = None
        if ghostty_bin is None:
            print("Ghostty is unavailable; Fontconfig selection will continue.", file=error)
    elif family.casefold() not in {supported.casefold() for supported in ghostty_families}:
        ghostty_supported = False
        print(f"Ghostty does not list {family} as supported; its font preference will remain "
              "unchanged while Fontconfig selection continues.", file=error)

    fontconfig_path = fontconfig_fragment_path()
    try:
        old_fontconfig = fontconfig_effective_family(run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        old_fontconfig = None
        print(f"Fontconfig's previous monospace value is unknown: {exception}; "
              "the selected preference will still be saved.", file=error)
    old_ghostty = None
    if ghostty_supported is not False and ghostty_bin:
        try:
            old_ghostty, ghostty_error = ghostty_configured_family(run=run)
        except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
            old_ghostty, ghostty_error = None, str(exception)
        if ghostty_error:
            print(f"Ghostty's previous configured family is unknown: {ghostty_error}; "
                  "Fontconfig selection will continue.", file=error)

    try:
        atomic_write(fontconfig_path, _fontconfig_fragment(family), mode=0o600)
    except (OSError, RuntimeError) as exception:
        print(f"Fontconfig preference was not saved: {exception}", file=error)
        return 1

    print(f"Saved monospace family: {family}", file=output)
    if families is None:
        print(f"Fontconfig could not confirm that {family} is installed; the requested preference "
              "was saved and its effective value is reported below.", file=error)
    try:
        effective = fontconfig_effective_family(run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        effective = None
        print(f"Fontconfig match could not be verified: {exception}; "
              f"the saved preference remains {family}.", file=error)
    print(f"Fontconfig effective monospace: {effective or 'unknown'}", file=output)
    if effective and effective.casefold() != family.casefold():
        print(f"Fontconfig did not resolve the selected family {family}; "
              f"the saved preference remains and {effective} is effective.", file=error)
    elif effective:
        print("New Fontconfig lookups use this family; cached applications may need a new launch.",
              file=output)
    if OMARCHY:
        print(f"Omarchy Fontconfig monospace selection: {old_fontconfig or 'unknown'} -> "
              f"{effective or 'unknown'}.", file=output)
        if effective and effective.casefold() == family.casefold():
            print("Selected by this explicit font command.", file=output)
        else:
            print(f"This explicit font command requested {family}; its effective Fontconfig "
                  f"result is {effective or 'unknown'}.", file=error)
    elif old_fontconfig and effective and old_fontconfig.casefold() != effective.casefold():
        print(f"Fontconfig monospace override: {old_fontconfig} -> {effective} (Gooarchy font choice).",
              file=output)

    if ghostty_supported is False:
        print(f"Ghostty font preference was not changed; Fontconfig remains saved as {family}.",
              file=error)
        return 0

    ghostty_fragment = ghostty_fragment_path()
    config_path = ghostty_config_path()
    ghostty_paths = (ghostty_fragment, config_path)
    ghostty_snapshots = {}
    try:
        ghostty_snapshots = {path: _snapshot(path) for path in ghostty_paths}
        atomic_write(ghostty_fragment, _ghostty_fragment(family), mode=0o600)
        original_config_bytes = (b"" if ghostty_snapshots[config_path] is None
                                 else ghostty_snapshots[config_path][0])
        original_config = original_config_bytes.decode("utf-8")
        updated_config = _ghostty_include(original_config, ghostty_fragment).encode("utf-8")
        if updated_config != original_config_bytes:
            atomic_write(config_path, updated_config, mode=0o600)
    except (OSError, UnicodeError, RuntimeError) as exception:
        restore_errors = []
        for path in reversed(ghostty_paths):
            if path not in ghostty_snapshots:
                continue
            try:
                _restore(path, ghostty_snapshots[path])
            except (OSError, RuntimeError) as restore_error:
                restore_errors.append(f"{path}: {restore_error}")
        detail = (f"Ghostty font configuration was not updated: {exception}; "
                  f"Fontconfig remains saved as {family}")
        if restore_errors:
            detail += "; Ghostty rollback failed: " + "; ".join(restore_errors)
        print(detail, file=error)
        return 0

    if not ghostty_bin:
        print(f"Ghostty: unavailable; Fontconfig is saved as {family}, and the Gooarchy font "
              "fragment is ready for a future Ghostty configuration.", file=error)
        return 0
    try:
        configured, config_error = ghostty_configured_family(run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        configured, config_error = None, str(exception)
    if config_error:
        print(f"Ghostty configuration is unknown ({config_error}); "
              f"Fontconfig remains saved as {family}.", file=error)
        return 0
    if configured is None:
        print(f"Ghostty configured family is unknown; Fontconfig remains saved as {family}.",
              file=error)
        return 0
    print(f"Ghostty configured family: {old_ghostty or 'unknown'} -> {configured}.", file=output)
    if configured.casefold() != family.casefold():
        print(f"Ghostty still resolves {configured}; Fontconfig remains saved as {family}.",
              file=error)
        return 0
    try:
        reloaded, detail = reload_ghostty(run=run)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
        reloaded, detail = False, str(exception)
    if not reloaded:
        print(f"Ghostty reload failed: {detail}; Fontconfig remains saved as {family}.", file=error)
        return 0
    print(f"{detail}; existing-window appearance is not inferred from the reload request.", file=output)
    return 0


def font_command(args, output=None, error=None, run=None):
    output = output or sys.stdout
    error = error or sys.stderr
    run = run or subprocess.run
    if args == ["current"]:
        return font_current(output=output, error=error, run=run)
    if args == ["list"]:
        if OMARCHY:
            print("Omarchy owns appearance; listing installed Fontconfig monospace families.",
                  file=error)
        try:
            fontconfig = font_inventory(run=run)
        except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
            print(f"Cannot list installed Fontconfig monospace fonts: {exception}", file=error)
            return 1
        ghostty_error = None
        try:
            ghostty = ghostty_font_families(run=run)
        except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as exception:
            ghostty = None
            ghostty_error = exception
        if ghostty is None:
            detail = f"unknown ({ghostty_error})" if ghostty_error else "unavailable"
            print(f"Ghostty compatibility is {detail}; listing installed Fontconfig monospace families.",
                  file=error)
        for family in fontconfig:
            print(family, file=output)
        return 0
    if len(args) == 2 and args[0] in ("set", "pick"):
        return set_font(args[1], output=output, error=error, run=run)
    print("usage: gooarchy-theme-integrations font <current|list|set FAMILY|pick FAMILY>", file=error)
    return 2


def apply(mode=None):
    if mode is not None and mode not in ("light", "dark"):
        raise ValueError("expected light or dark")
    # Keep exactly the same Omarchy marker used by Gooarchy flavorings' shared guard.
    if OMARCHY:
        return 0
    try:
        values = palette(mode)
    except (OSError, UnicodeError, RuntimeError, KeyError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"Gooarchy: optional Strata/Chromium theme colors are unavailable: {error}; "
              "the requested theme links remain selected.", file=sys.stderr)
        return 0
    try:
        update_strata(values)
    except (OSError, UnicodeError, RuntimeError, KeyError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"Gooarchy: couldn't update Strata's Gooarchy theme: {error}; "
              "the requested theme links remain selected and Chromium will still be updated.",
              file=sys.stderr)
    color = values.get("accent", "").lower()
    if not re.fullmatch(r"#[0-9a-f]{6}", color):
        print("Gooarchy: Chromium's selected theme accent is unavailable; "
              "the requested theme links remain selected.", file=sys.stderr)
        return 0
    try:
        update_chromium(color)
    except (OSError, UnicodeError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"Gooarchy: Chromium theme integration failed: {error}; "
              "the requested theme links remain selected.", file=sys.stderr)
    return 0


def main():
    args = sys.argv[1:]
    if args and args[0] == "font":
        return font_command(args[1:])
    if len(args) > 1 or (len(args) == 1 and args[0] not in ("light", "dark")):
        print("usage: gooarchy-theme-integrations [light|dark] | "
              "font <current|list|set FAMILY|pick FAMILY>",
              file=sys.stderr)
        return 2
    return apply(args[0] if args else None)


if __name__ == "__main__":
    raise SystemExit(main())
