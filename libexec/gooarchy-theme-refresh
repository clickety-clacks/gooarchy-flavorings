#!/usr/bin/env python3
"""Refresh the two current-theme links from the selected theme record."""
import fcntl
import hashlib
import json
import os
import stat
import subprocess
import sys
import time
import uuid
from pathlib import Path

LOOKUP = Path(__file__).with_name("gooarchy-theme-lookup")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CURRENT_THEME = CONFIG_HOME / "gooarchy" / "current-theme"
MODES = ("light", "dark")
WALLPAPER_RUNTIME_CONTROL_PREFIX = "gooarchy-wallpaper"


def _sync_directory(path):
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _reapply_scottland_palette(run):
    if not os.environ.get("XDG_RUNTIME_DIR") or not os.environ.get("WAYLAND_DISPLAY"):
        return
    hooks = Path(os.environ.get("SCOTTLAND_HOOKS") or "/usr/lib/scottland")
    command = hooks / "libexec" / "scottland-color-scheme"
    if not command.is_file():
        raise RuntimeError(f"Scottland color-scheme reapply is unavailable: {command}")
    try:
        result = run([str(command), "once"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Scottland color-scheme reapply failed: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or "command returned a failure status"
        raise RuntimeError(f"Scottland color-scheme reapply failed: {detail}")


def _wallpaper_runtime_paths(runtime_path):
    display = os.environ.get("WAYLAND_DISPLAY")
    if not display:
        return None, None, None
    display_id = hashlib.sha256(display.encode("utf-8")).hexdigest()
    prefix = f"{WALLPAPER_RUNTIME_CONTROL_PREFIX}.{display_id}"
    return (runtime_path / f"{prefix}.lock",
            runtime_path / f"{prefix}.request",
            runtime_path / f"{prefix}.ack")


def _refresh_running_wallpaper():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not Path(runtime).is_dir() or not os.environ.get("WAYLAND_DISPLAY"):
        return
    runtime_path = Path(runtime)
    lock_path, request_path, ack_path = _wallpaper_runtime_paths(runtime_path)
    try:
        lock_fd = os.open(lock_path, os.O_RDWR | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return
    try:
        metadata = os.fstat(lock_fd)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise RuntimeError(f"refusing unexpected wallpaper lock: {lock_path}")
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            helper_running = True
        else:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            helper_running = False
    finally:
        os.close(lock_fd)
    if not helper_running:
        return

    token = uuid.uuid4().hex
    temp = request_path.with_name(f".{request_path.name}.{uuid.uuid4().hex}.tmp")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(token + "\n")
            stream.flush()
        os.replace(temp, request_path)
    except BaseException:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass
        raise

    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            ack_fd = os.open(ack_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        except FileNotFoundError:
            acknowledged = False
        else:
            with os.fdopen(ack_fd, "r") as stream:
                acknowledged = stream.read(128).strip() == token
        if acknowledged:
            return
        try:
            active_fd = os.open(lock_path, os.O_RDWR | getattr(os, "O_NOFOLLOW", 0))
        except FileNotFoundError:
            raise RuntimeError("running wallpaper exited before completing its refresh")
        try:
            try:
                fcntl.flock(active_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                pass
            else:
                fcntl.flock(active_fd, fcntl.LOCK_UN)
                raise RuntimeError("running wallpaper exited before completing its refresh")
        finally:
            os.close(active_fd)
        time.sleep(0.05)
    raise RuntimeError("running wallpaper did not complete its refresh within five seconds")


def _prepare_location(current):
    if current.is_symlink():
        raise RuntimeError(f"refusing symlinked current-theme location: {current}")
    if current.exists() and not current.is_dir():
        raise RuntimeError(f"current-theme location is not a directory: {current}")
    current.mkdir(mode=0o700, parents=True, exist_ok=True)
    for entry in current.iterdir():
        if entry.name in MODES:
            if not entry.is_symlink():
                raise RuntimeError(f"refusing non-symlink current-theme entry: {entry.name}")
        else:
            raise RuntimeError(f"unexpected current-theme entry: {entry.name}")


def refresh(current_theme=CURRENT_THEME, lookup=LOOKUP, run=subprocess.run):
    if Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy").is_dir():
        return 0
    current = Path(current_theme)
    parent = current.parent
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_path = parent / ".current-theme-refresh.lock"
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    lock_fd = os.open(lock_path, flags, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        try:
            result = run([str(lookup), "--pair"], capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError) as error:
            raise RuntimeError(f"theme lookup failed: {error}") from error
        if result.returncode != 0:
            detail = result.stderr.strip() or "lookup returned no targets"
            raise RuntimeError(f"theme lookup failed: {detail}")
        try:
            targets = json.loads(result.stdout)
        except (TypeError, json.JSONDecodeError) as error:
            raise RuntimeError(f"theme lookup returned invalid targets: {error}") from error
        if (not isinstance(targets, dict) or set(targets) != set(MODES)
                or any(not isinstance(targets[mode], str)
                       or not Path(targets[mode]).is_absolute() for mode in MODES)):
            raise RuntimeError("theme lookup returned invalid targets: expected absolute light/dark paths")

        _prepare_location(current)
        for mode in MODES:
            temp = parent / f".{current.name}.{mode}.{uuid.uuid4().hex}.tmp"
            destination = current / mode
            try:
                os.symlink(targets[mode], temp)
                os.replace(temp, destination)
                _sync_directory(current)
                _sync_directory(parent)
            finally:
                try:
                    temp.unlink()
                except FileNotFoundError:
                    pass
        _reapply_scottland_palette(run)
        _refresh_running_wallpaper()
    finally:
        os.close(lock_fd)
    return 0


def main(argv=None):
    args = sys.argv[1:] if argv is None else list(argv)
    if args:
        print("usage: gooarchy-theme-refresh", file=sys.stderr)
        return 2
    try:
        return refresh()
    except (OSError, RuntimeError) as error:
        print(f"gooarchy-theme-refresh: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
