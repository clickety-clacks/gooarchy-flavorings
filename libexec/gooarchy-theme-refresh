#!/usr/bin/env python3
"""Refresh the two current-theme links from the selected theme record."""
import fcntl
import json
import os
import subprocess
import sys
import uuid
from pathlib import Path

LOOKUP = Path(__file__).with_name("gooarchy-theme-lookup")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CURRENT_THEME = CONFIG_HOME / "gooarchy" / "current-theme"
MODES = ("light", "dark")


def _sync_directory(path):
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _prepare_location(current):
    if current.is_symlink():
        raise RuntimeError(f"refusing symlinked current-theme location: {current}")
    if current.exists() and not current.is_dir():
        raise RuntimeError(f"current-theme location is not a directory: {current}")
    current.mkdir(mode=0o700, parents=True, exist_ok=True)
    for entry in current.iterdir():
        if entry.name in MODES:
            if not entry.is_symlink():
                raise RuntimeError(f"refusing non-symlink current-theme entry: {entry.name}")
        else:
            raise RuntimeError(f"unexpected current-theme entry: {entry.name}")


def refresh(current_theme=CURRENT_THEME, lookup=LOOKUP, run=subprocess.run):
    current = Path(current_theme)
    parent = current.parent
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_path = parent / ".current-theme-refresh.lock"
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    lock_fd = os.open(lock_path, flags, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        try:
            result = run([str(lookup), "--pair"], capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError) as error:
            raise RuntimeError(f"theme lookup failed: {error}") from error
        if result.returncode != 0:
            detail = result.stderr.strip() or "lookup returned no targets"
            raise RuntimeError(f"theme lookup failed: {detail}")
        try:
            targets = json.loads(result.stdout)
        except (TypeError, json.JSONDecodeError) as error:
            raise RuntimeError(f"theme lookup returned invalid targets: {error}") from error
        if (not isinstance(targets, dict) or set(targets) != set(MODES)
                or any(not isinstance(targets[mode], str)
                       or not Path(targets[mode]).is_absolute() for mode in MODES)):
            raise RuntimeError("theme lookup returned invalid targets: expected absolute light/dark paths")

        _prepare_location(current)
        for mode in MODES:
            temp = parent / f".{current.name}.{mode}.{uuid.uuid4().hex}.tmp"
            destination = current / mode
            try:
                os.symlink(targets[mode], temp)
                os.replace(temp, destination)
                _sync_directory(current)
                _sync_directory(parent)
            finally:
                try:
                    temp.unlink()
                except FileNotFoundError:
                    pass
    finally:
        os.close(lock_fd)
    return 0


def main(argv=None):
    args = sys.argv[1:] if argv is None else list(argv)
    if args:
        print("usage: gooarchy-theme-refresh", file=sys.stderr)
        return 2
    try:
        return refresh()
    except (OSError, RuntimeError) as error:
        print(f"gooarchy-theme-refresh: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
